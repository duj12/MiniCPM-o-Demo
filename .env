# Docker Compose 环境变量 — 供 docker-compose.cpp.yml 使用
# 启动：docker compose -f docker-compose.cpp.yml up -d

# ============ 模型选择 ============
# 一次只启用一个模型（注释掉另一个）
#
# MiniCPM-o-4.5（默认，支持全双工）
# ACTIVE_MODEL=minicpm
# LLAMA_SERVER_EXTRA_ARGS=-c 32768 --parallel 4
#
# Qwen3-Omni-30B（turn-based，支持多模态输入）
ACTIVE_MODEL=qwen3omni
LLAMA_SERVER_EXTRA_ARGS=-c 16384 --parallel 2 -b 1024

# ============ 通用配置 ============
# 模型根目录（必须存在），挂载到容器的 /models
GGUF_MODEL_HOST_PATH=/data/megastore/Projects/DuJing/models
CPP_GPU_ID=0
GATEWAY_HOST_PORT=8006

# ============ VAD + TurnSense 半双工参数 ============
# 服务端默认值；每次连接时前端/调用方可通过 config 覆盖（优先级: 请求 > env > 默认值）
# VAD 尾静音（ms）：说话停顿多久判定一句话说完
VAD_TAIL_SIL=600
# VAD 最大段长（ms）：超过则强制切段
VAD_MAX_LEN=60000
# VAD 处理窗口（ms）
VAD_CHUNK_SIZE=200
# TurnSense incomplete 等待（ms）：语义不完整时等多久，超时强制回复
TS_INCOMPLETE_WAIT_MS=1000
# TurnSense invalid 丢弃阈值（0~1）：invalid 概率 ≥ 此值则丢弃该句不回复
TS_INVALID_THRESHOLD=0.5
