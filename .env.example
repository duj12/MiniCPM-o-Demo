# Docker Compose / Orchestrator 环境变量
# 复制为 .env 后按需修改：cp .env.example .env

# ============ 模型选择 ============
# 一次只启用一个模型（注释掉另一个）
#
# MiniCPM-o-4.5（默认，支持全双工）
# ACTIVE_MODEL=minicpm
# LLAMA_SERVER_EXTRA_ARGS=-c 32768 --parallel 4
#
# Qwen3-Omni-30B（turn-based，支持多模态输入）
ACTIVE_MODEL=qwen3omni
# 大上下文 + 多路并发时调整；超出单卡显存会 OOM。
# 双卡显存靠 MTMD_BACKEND_DEVICE=CUDA1（mmproj 搬 GPU1）平衡，不要用 -ts 偏置
# （实测 -ts 2,3 会把太多层/KV 压到 GPU1 导致 OOM）。
LLAMA_SERVER_EXTRA_ARGS=-c 256000 --parallel 10

# ============ 通用配置 ============
# 模型根目录，挂载到容器 /models。默认 ./checkpoints（项目内三子目录）：
#   checkpoints/{qwen3omni-gguf, fsmn-vad-onnx, TurnSense}
# 可覆盖为 SVN 下载目录或别处。
MODEL_HOST_PATH=./checkpoints
# GPU 分配（entrypoint 的 --gpu-id 等；容器实际暴露的 GPU 由 compose device_ids 控制）
CPP_GPU_ID=0
GATEWAY_HOST_PORT=8006
# Gateway 每 worker 最大并发 session 数（需与 C++ --parallel 匹配）
WORKER_MAX_CONCURRENCY=4

# ============ State Head（typed-question 状态模型，可选）============
# 与 cpp-worker-backend **共用 GPU0**，所以启用前必须先把 omni 的 context 降下来：
#   LLAMA_SERVER_EXTRA_ARGS=-c 200000 --parallel 10   （per-slot 25600 → 20000，KV 少约 22%）
# 启动：docker compose -f docker-compose.cpp.yml --profile state-head up -d state-head
# 重启 omni 前先 docker stop omni-llm-state-head，否则 omni 重预分配 KV 可能失败。
STATE_MODEL_DIR=onejev-1.6-0.8b
STATE_GPU_ID=0
STATE_REPLICAS=1
# 副本是否摊到不同卡；共用一张卡时必须为 0（否则 CUDA 看不到设备）
STATE_REPLICA_SPREAD=0
STATE_HEAD_HOST_PORT=22520
# flide 跨请求合批：首个请求到达后再等几毫秒收拢同批请求
STATE_BATCH_WINDOW_MS=3
STATE_GATHER_MS=2
STATE_PLANNERS=4
STATE_FRONTENDS=2
# 与 omni 共卡必须关 CUDA graph（显存/预热时间）
STATE_NO_CUDA_GRAPHS=1
# 发前把帧缩到长边 640（延迟与显存的主旋钮；0=不缩）
STATE_MAX_MEDIA_PX=640
STATE_TIMEOUT_S=3.0
STATE_TIER2=0

# ============ VAD + TurnSense 半双工参数 ============
# 服务端默认值；每次连接时可通过 config 覆盖（优先级: 请求 > env > 默认值）
# VAD 尾静音（ms）：说话停顿多久判定一句话说完
VAD_TAIL_SIL=600
# VAD 最大段长（ms）：超过则强制切段
VAD_MAX_LEN=30000
# TurnSense incomplete 等待（ms）：语义不完整时等多久，超时强制回复
TS_INCOMPLETE_WAIT_MS=1000
# TurnSense invalid 丢弃阈值（0~1）：invalid 概率 ≥ 此值则丢弃该句不回复
TS_INVALID_THRESHOLD=0.5

# ============ Orchestrator 本地联调 ============
# python -m orchestrator.main 自动读取本文件；终端环境变量优先。
# 以下示例连接本地 Agent 与远端感知/TTS 服务，可按部署修改地址。
ORCH_INTERACTION=1
ORCH_IC_MODE=inprocess
ORCH_DOWNSTREAM_MODE=omni
# openai-agent-demo 在另一个终端执行 python app.py，提供 gRPC 服务。
ORCH_AGENT_GRPC=127.0.0.1:50051
# Omni 只生成视觉描述，最终答复由 Agent 生成。
ORCH_OMNI_URL=wss://192.168.89.106:8006/v1/realtime?mode=video
ORCH_OMNI_DESCRIBE=1
# IC 的语音 ANSWER 依赖人脸在场；仅有视觉描述不能替代人脸状态。
ORCH_ENABLE_FACE=1
ORCH_FACE_SERVICE_URL=http://192.168.89.105:8767
# 浏览器原生 AEC，不依赖云端 AEC 服务。
ORCH_AEC_MODE=browser
ORCH_ASR_URL=ws://192.168.88.101:31366
ORCH_TTS_HOST=192.168.88.253
ORCH_TTS_PORT=31058

# ---- 带置信度的 E2 状态（state head）----
# 1 = 除 Qwen3-Omni 的文本描述之外，并行调 state head 拿枚举值 + 置信度；
#     0 = 老行为（纯文本 8 键，无置信度）。
ORCH_STATE_HEAD=0
# state head 地址。跨机部署时填宿主机 IP，不是 127.0.0.1。
ORCH_STATE_URL=http://127.0.0.1:22520
# 超时即丢弃本轮 state，退回纯文本；**不阻塞 on_answer**
ORCH_STATE_TIMEOUT_S=0.8
# 送给 state head 的帧数（2 帧 = 当前 + 1 秒前，motion/duration 靠它）
ORCH_STATE_N_FRAMES=2
# 发前把帧长边缩到多少（与 STATE_MAX_MEDIA_PX 对应）
ORCH_STATE_MAX_PX=640
# 渲染成 "EMOTION: dissatisfied (0.82)" 形态
ORCH_STATE_CONF_IN_TEXT=1
# Qwen3-Omni 只出自由文本槽位（FEATURE / ENV.objects / POSITION / 一行描述）
ORCH_TEXT_SHORT=1
