# syntax=docker/dockerfile:1
#
# C++ worker + backend bundle image.
#
# One container runs:
#   - llama.cpp-omni llama-omni-server on 127.0.0.1:${BACKEND_PORT:-22500}
#   - worker.py on 0.0.0.0:${WORKER_PORT:-22400}, forwarding to the local backend
#
# Model weights are mounted at runtime; they are not baked into the image.

ARG CUDA_VERSION=12.8.1
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS cpp-build

ARG LLAMA_OMNI_REPO=https://github.com/duj12/llama.cpp-omni.git
ARG LLAMA_OMNI_REFSPEC=dev
ARG LLAMA_OMNI_REF=origin/dev
ARG LLAMA_OMNI_SERVER_TARGET=llama-omni-server
ARG LLAMA_OMNI_SERVER_BIN=llama-omni-server
ARG LLAMA_QWEN3OMNI_SERVER_TARGET=llama-qwen3omni-server
ARG LLAMA_QWEN3OMNI_SERVER_BIN=llama-qwen3omni-server
ARG CMAKE_CUDA_ARCHITECTURES=80;86;120

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libgomp1 \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# 构建时从 git 拉取 llama.cpp-omni 源码（不再依赖本地 docker/llama.cpp-omni 同步目录）。
# 默认 duj12/dev 分支，可用 --build-arg LLAMA_OMNI_REPO / LLAMA_OMNI_REFSPEC 覆盖。
# CACHE_BUST：git clone 层缓存命中会导致 remote 新 commit 不生效（buildkit 按命令串
# 判缓存），每次 build 传不同 CACHE_BUST（如时间戳）强制重新 clone + 重编。
ARG CACHE_BUST
RUN git clone --depth 1 -b ${LLAMA_OMNI_REFSPEC} ${LLAMA_OMNI_REPO} /src/llama.cpp-omni \
    && echo "cache_bust=${CACHE_BUST}" > /src/llama.cpp-omni/CACHE_BUST

WORKDIR /src/llama.cpp-omni

RUN cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=ON \
    -DGGML_NATIVE=OFF \
    -DLLAMA_CURL=OFF \
    -DLLAMA_OPENSSL=OFF \
    -DLLAMA_BUILD_SERVER=ON \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
    -DCMAKE_CUDA_ARCHITECTURES="${CMAKE_CUDA_ARCHITECTURES}" \
    && cmake --build build --target "${LLAMA_OMNI_SERVER_TARGET}" -j "$(nproc)" \
    && cmake --build build --target "${LLAMA_QWEN3OMNI_SERVER_TARGET}" -j "$(nproc)" \
    && mkdir -p /opt/llama.cpp-omni/bin \
    && cp -a "build/bin/${LLAMA_OMNI_SERVER_BIN}" "build/bin/${LLAMA_QWEN3OMNI_SERVER_BIN}" build/bin/*.so* /opt/llama.cpp-omni/bin/

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    LD_LIBRARY_PATH=/opt/llama.cpp-omni/bin:/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    PATH=/opt/venv/bin:${PATH} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    libgomp1 \
    python3 \
    python3-pip \
    python3-venv \
    supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    "fastapi>=0.128.0" \
    "httpx>=0.28.0" \
    "kaldi_native_fbank>=1.0.0" \
    "numpy>=2.2.0" \
    "onnxruntime>=1.17.0" \
    "pydantic>=2.11.0" \
    "pyyaml>=6.0" \
    python-multipart \
    "uvicorn>=0.40.0" \
    "websockets>=16.0"

COPY --from=cpp-build /opt/llama.cpp-omni /opt/llama.cpp-omni
COPY . .

# ── 模型打包进镜像（可选）──────────────────────────────
# BUNDLE_MODELS=1：把构建上下文的 .bundle-checkpoints/（由 build-image.sh 软链
# 实体化生成，含 qwen3omni-gguf/fsmn-vad-onnx/TurnSense）拷进 /app/checkpoints。
# 未打包时镜像内无模型，half_duplex 会从 /models（compose 挂载点）探测。
ARG BUNDLE_MODELS=0
RUN if [ "$BUNDLE_MODELS" = "1" ] && [ -d .bundle-checkpoints ]; then \
        mkdir -p /app/checkpoints \
        && cp -r .bundle-checkpoints/checkpoints/. /app/checkpoints/; \
    fi

# ── supervisor 服务管理 ───────────────────────────────
# 两个服务（llama server + worker）都由 supervisord 管理，autorestart + 日志落位
# /app/logs。supervisord.conf 由 entrypoint 按 ACTIVE_MODEL 动态生成（llama 参数
# 因模型而异），entrypoint 负责判断/校验后 exec supervisord。

RUN chmod +x docker/entrypoint-cpp-worker-backend.sh \
    && mkdir -p /app/logs /var/log/supervisor

EXPOSE 22500
EXPOSE 22400

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=40 \
    CMD curl -sf "http://127.0.0.1:${WORKER_PORT:-22400}/health" >/dev/null || exit 1

ENTRYPOINT ["docker/entrypoint-cpp-worker-backend.sh"]
