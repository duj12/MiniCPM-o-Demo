# 使用 BuildKit 内置 Dockerfile 前端，避免额外拉取 docker/dockerfile 镜像。
#
# C++ worker + backend bundle image.
#
# One container runs:
#   - llama.cpp-omni llama-omni-server on 127.0.0.1:${BACKEND_PORT:-22500}
#   - worker.py on 0.0.0.0:${WORKER_PORT:-22400}, forwarding to the local backend
#
# Model weights can be bundled by build-image.sh or mounted at runtime.

ARG CUDA_VERSION=12.8.1
ARG UBUNTU_VERSION=22.04
ARG BUNDLE_MODELS=0

FROM harbor.xmov.ai/xmov/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS cpp-build

ARG LLAMA_OMNI_REPO=https://github.com/duj12/llama.cpp-omni.git
ARG LLAMA_OMNI_REFSPEC=dev
ARG LLAMA_OMNI_REF=origin/dev
ARG LLAMA_OMNI_SERVER_TARGET=llama-omni-server
ARG LLAMA_OMNI_SERVER_BIN=llama-omni-server
ARG LLAMA_QWEN3OMNI_SERVER_TARGET=llama-qwen3omni-server
ARG LLAMA_QWEN3OMNI_SERVER_BIN=llama-qwen3omni-server
ARG CMAKE_CUDA_ARCHITECTURES=80;86;120

RUN find /etc/apt -maxdepth 2 -type f \( -name '*.list' -o -name '*.sources' \) \
        -exec sed -i -E \
            -e 's|https?://([[:alnum:].-]+\.)?archive\.ubuntu\.com/ubuntu/?|http://mirrors.aliyun.com/ubuntu/|g' \
            -e 's|https?://security\.ubuntu\.com/ubuntu/?|http://mirrors.aliyun.com/ubuntu/|g' {} + \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libgomp1 \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# 源码来源：构建机本地 llama.cpp-omni-dev/（宿主机 clone duj12/dev 后构建）。
# 不在容器内 git clone —— 部分网络到 github 不稳定（HTTP2/TLS 反复断开），
# 容器内 clone 经常失败。由 build-image.sh 先确保 llama.cpp-omni-dev/ 存在。
# LLAMA_OMNI_REFSPEC 保留作文档说明（实际用本地目录）。
ARG LLAMA_OMNI_REFSPEC=dev
COPY .llama-src/ /src/llama.cpp-omni

WORKDIR /src/llama.cpp-omni

RUN cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=ON \
    -DGGML_NATIVE=OFF \
    -DLLAMA_CURL=OFF \
    -DLLAMA_OPENSSL=OFF \
    -DLLAMA_BUILD_SERVER=ON \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
    -DCMAKE_CUDA_ARCHITECTURES="${CMAKE_CUDA_ARCHITECTURES}" \
    && cmake --build build --target "${LLAMA_OMNI_SERVER_TARGET}" -j "$(nproc)" \
    && cmake --build build --target "${LLAMA_QWEN3OMNI_SERVER_TARGET}" -j "$(nproc)" \
    && mkdir -p /opt/llama.cpp-omni/bin \
    && cp -a "build/bin/${LLAMA_OMNI_SERVER_BIN}" "build/bin/${LLAMA_QWEN3OMNI_SERVER_BIN}" build/bin/*.so* /opt/llama.cpp-omni/bin/

FROM harbor.xmov.ai/xmov/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS runtime-base

ENV DEBIAN_FRONTEND=noninteractive \
    LD_LIBRARY_PATH=/opt/llama.cpp-omni/bin:/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    PATH=/opt/venv/bin:${PATH} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

RUN find /etc/apt -maxdepth 2 -type f \( -name '*.list' -o -name '*.sources' \) \
        -exec sed -i -E \
            -e 's|https?://([[:alnum:].-]+\.)?archive\.ubuntu\.com/ubuntu/?|http://mirrors.aliyun.com/ubuntu/|g' \
            -e 's|https?://security\.ubuntu\.com/ubuntu/?|http://mirrors.aliyun.com/ubuntu/|g' {} + \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    libgomp1 \
    python3 \
    python3-pip \
    python3-venv \
    supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url https://mirrors.aliyun.com/pypi/simple/ \
    "fastapi>=0.128.0" \
    "httpx>=0.28.0" \
    "kaldi_native_fbank>=1.0.0" \
    "numpy>=2.2.0" \
    "onnxruntime>=1.17.0" \
    "pydantic>=2.11.0" \
    "pyyaml>=6.0" \
    python-multipart \
    "uvicorn>=0.40.0" \
    "websockets>=16.0"

# ── 模型打包进镜像（可选）──────────────────────────────
# 不打包时跳过整个模型阶段，直接 compose build 也不要求暂存目录存在。
FROM runtime-base AS runtime-models-0

FROM runtime-base AS runtime-models-1
# 放在代码和 C++ 产物之前，代码变化不会使约 20 GB 的模型层失效。
COPY .bundle-checkpoints/checkpoints/ /app/checkpoints/

FROM runtime-models-${BUNDLE_MODELS} AS worker
COPY --from=cpp-build /opt/llama.cpp-omni /opt/llama.cpp-omni
# 仅拷 worker 的运行依赖，不带入 gateway、模型暂存目录或 C++ 源码。
COPY worker.py worker_state.py config.py ./
COPY runtime/ ./runtime/
COPY vad/ ./vad/
COPY assets/ ./assets/
COPY docker/entrypoint-cpp-worker-backend.sh ./docker/entrypoint-cpp-worker-backend.sh

# ── supervisor 服务管理 ───────────────────────────────
# 两个服务（llama server + worker）都由 supervisord 管理，autorestart + 日志落位
# /app/logs。supervisord.conf 由 entrypoint 按 ACTIVE_MODEL 动态生成（llama 参数
# 因模型而异），entrypoint 负责判断/校验后 exec supervisord。

RUN chmod +x docker/entrypoint-cpp-worker-backend.sh \
    && mkdir -p /app/logs /var/log/supervisor

EXPOSE 22500
EXPOSE 22400

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=40 \
    CMD curl -sf "http://127.0.0.1:${WORKER_PORT:-22400}/health" >/dev/null || exit 1

ENTRYPOINT ["docker/entrypoint-cpp-worker-backend.sh"]
